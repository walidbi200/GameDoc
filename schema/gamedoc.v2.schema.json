{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/walidbi200/GameDoc/main/schema/gamedoc.v2.schema.json",
  "title": "GameDoc Report",
  "description": "Deterministic, read-only Linux gaming diagnostics report.",
  "type": "object",
  "required": ["schema", "gamedoc_version", "facts", "problems", "checks"],
  "properties": {
    "schema_url": {
      "type": "string"
    },
    "schema": {
      "type": "string",
      "const": "gamedoc.v2"
    },
    "gamedoc_version": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/problem"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fact": {
      "type": "object",
      "required": ["id", "category", "value", "confidence", "source"],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "value": {},
        "confidence": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["collector", "method"],
          "properties": {
            "collector": { "type": "string" },
            "method": { "type": "object" }
          }
        }
      }
    },
    "problem": {
      "type": "object",
      "required": ["id", "category", "severity", "summary", "details"],
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "summary": { "type": "string" },
        "details": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendation": {
          "type": ["object", "null"],
          "required": ["text", "difficulty", "est_minutes", "requires_root", "requires_reboot"],
          "properties": {
            "text": { "type": "string" },
            "platform_specific": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
            "est_minutes": { "type": "integer" },
            "requires_root": { "type": "boolean" },
            "requires_reboot": { "type": "boolean" },
            "docs_url": { "type": ["string", "null"] }
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": ["collector", "operation", "message"],
      "properties": {
        "collector": { "type": "string" },
        "operation": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
